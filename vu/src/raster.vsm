    nop                                  sqi.xyzw vf21, (vi11++)             ;  231
    nop                                  sqi.xyzw vf18, (vi11++)             ;  232
    nop                                  isubiu vi12, vi03, 6                ;  233
    nop                                  lq.xyzw vf22, 1(vi12)               ;  234
    nop                                  lq.xyzw vf21, 2(vi12)               ;  235
    nop                                  nop                                 ;  236
    nop                                  iaddiu vi12, vi12, 3                ;  237
    nop                                  iswr.x vi05, (vi11)                 ;  238
    nop                                  iswr.y vi00, (vi11)                 ;  239
    nop                                  iaddiu vi11, vi11, 1                ;  240
    nop                                  nop                                 ;  241
    nop                                  sqi.xyzw vf16, (vi11++)             ;  242
    nop                                  sqi.xyzw vf22, (vi11++)             ;  243
    nop                                  sqi.xyzw vf21, (vi11++)             ;  244
    nop                                  sqi.xyzw vf19, (vi11++)             ;  245
    nop                                  lq.xyzw vf22, 1(vi12)               ;  246
    nop                                  lq.xyzw vf21, 2(vi12)               ;  247
    nop                                  nop                                 ;  248
    nop                                  iaddiu vi12, vi12, 3                ;  249
    nop                                  iswr.x vi06, (vi11)                 ;  250
    nop                                  iswr.y vi00, (vi11)                 ;  251
    nop                                  iaddiu vi11, vi11, 1                ;  252
    nop                                  nop                                 ;  253
    nop                                  sqi.xyzw vf17, (vi11++)             ;  254
    nop                                  sqi.xyzw vf22, (vi11++)             ;  255
.vif 0x00000000
.mpg 256
    nop                                  sqi.xyzw vf21, (vi11++)             ;  256
    nop                                  sqi.xyzw vf20, (vi11++)             ;  257
    nop                                  iaddiu vi12, vi00, 142              ;  258
    nop                                  lq.xyzw vf22, 1(vi12)               ;  259
    nop                                  lq.xyzw vf21, 2(vi12)               ;  260
    nop                                  nop                                 ;  261
    nop                                  iaddiu vi12, vi12, 3                ;  262
    nop                                  iswr.x vi04, (vi11)                 ;  263
    nop                                  iswr.y vi00, (vi11)                 ;  264
    nop                                  iaddiu vi11, vi11, 1                ;  265
    nop                                  nop                                 ;  266
    nop                                  sqi.xyzw vf15, (vi11++)             ;  267
    nop                                  sqi.xyzw vf22, (vi11++)             ;  268
    nop                                  sqi.xyzw vf21, (vi11++)             ;  269
    nop                                  sqi.xyzw vf18, (vi11++)             ;  270
    nop                                  iaddiu vi09, vi00, 3                ;  271
    nop                                  bal vi14, clip_polygon                     ;  272
    nop                                  nop                                 ;  273
    nop                                  ibeq vi11, vi00, clip_fan_return              ;  274
    nop                                  nop                                 ;  275
    nop                                  iadd vi01, vi00, vi11               ;  276
    nop                                  iadd vi02, vi00, vi12               ;  277
    nop                                  iaddiu vi03, vi00, 1                ;  278
    nop                                  bal vi12, layer_emitter                     ;  279
    nop                                  nop                                 ;  280
clip_fan_return:
    nop                                  ilwr.x vi11, (vi15)                 ;  281
    nop                                  ilwr.y vi12, (vi15)                 ;  282
    nop                                  ilwr.z vi13, (vi15)                 ;  283
    nop                                  ilwr.w vi14, (vi15)                 ;  284
    nop                                  iaddiu vi15, vi15, 1                ;  285
    nop                                  ilwr.x vi07, (vi15)                 ;  286
    nop                                  ilwr.y vi08, (vi15)                 ;  287
    nop                                  ilwr.z vi09, (vi15)                 ;  288
    nop                                  ilwr.w vi10, (vi15)                 ;  289
    nop                                  iaddiu vi15, vi15, 1                ;  290
    nop                                  ilwr.x vi03, (vi15)                 ;  291
    nop                                  ilwr.y vi04, (vi15)                 ;  292
    nop                                  ilwr.z vi05, (vi15)                 ;  293
    nop                                  ilwr.w vi06, (vi15)                 ;  294
    nop                                  iaddiu vi15, vi15, 1                ;  295
    nop                                  ilwr.x vi01, (vi15)                 ;  296
    nop                                  ilwr.y vi02, (vi15)                 ;  297
    nop                                  iaddiu vi15, vi15, 1                ;  298
    nop                                  lqi.xyzw vf28, (vi15++)             ;  299
    nop                                  lqi.xyzw vf27, (vi15++)             ;  300
    nop                                  lqi.xyzw vf26, (vi15++)             ;  301
    nop                                  lqi.xyzw vf25, (vi15++)             ;  302
    nop                                  lqi.xyzw vf24, (vi15++)             ;  303
    nop                                  lqi.xyzw vf23, (vi15++)             ;  304
    nop                                  lqi.xyzw vf22, (vi15++)             ;  305
    nop                                  lqi.xyzw vf21, (vi15++)             ;  306
    nop                                  lqi.xyzw vf20, (vi15++)             ;  307
    nop                                  lqi.xyzw vf19, (vi15++)             ;  308
    nop                                  lqi.xyzw vf18, (vi15++)             ;  309
    nop                                  lqi.xyzw vf17, (vi15++)             ;  310
    nop                                  lqi.xyzw vf16, (vi15++)             ;  311
    nop                                  lqi.xyzw vf15, (vi15++)             ;  312
    nop                                  ibgtz vi02, fan_loop                   ;  313
    nop                                  nop                                 ;  314
    nop                                  b fan_exit                             ;  315
    nop                                  nop                                 ;  316
; ===========================================================================
; VIRStrip -- transform, light, cull and pack one triangle strip (VUNC layout).
; READ AND VERIFIED 2026-10-17: spec_strip.py is this loop as a per-vertex
; function, and test_spec_strip.py holds it to vusim over every VIRStrip run in
; a live capture (688 runs, 4,676 vertices, bit for bit, paths included).
;
; in   TOP: vertex count N, then N x (P.xyz, (s,t,q), N.xyz, rgba) floats
; out  142 + 3n: XYZF2 (ftoi4 x/w, y/w, z/w, fog; bit 15 of w = ADC),
;      (s, t, q/w, fog), rgba floats -- an INTERMEDIATE buffer: layer_emitter turns it
;      into one GIF packet per material layer (UV transform, 1/w, int colour)
;
; It is software-pipelined: one pass of strip_loop finishes vertex n (lighting,
; culling, the three stores) while it loads and transforms vertex n+1, so read
; a pass as two vertices interleaved.  Registers, for vertex n:
;   vf21 P  vf22 (s,t,q) then STQ out  vf23 N  vf24 colour
;   vf31 model->screen (homogeneous)  vf20 screen = vf31/w, w = fog
;   vf17 model->clip  vf18/vf19 the two previous screen positions
;   vf26 L = light - P, then L.N; vf25.x N.S (opmula/madda.x/opmsub: a dot
;        product, which is why the sun is uploaded as (x, -z, y)), .w distance
;   Q 1/w (div at 343, read at 350/356: 7 cycles)  P 1/|L| (erleng 338 -> 362)
;   vi02 vertices left  vi13 2 then counts down (no triangle until n = 2)
;   vi04/vi05/vi06 clip codes of n-2, n-1, n   vi09 winding parity (0/32)
;   vi03 output pointer   vi12 0x8000 (ADC)   vi15 stack: [N, drawn]
; colour = min(c + amb + sun*max(-N.S, 0) + pt*(1 - min(|L|/range, 1))
;          * max(L.N/|L|, 0), 1), alpha = c.w
; fog    = clamp(w*scale + offset, near, far)
; per triangle (n-2, n-1, n), first match wins:
;   AND of the three clip codes != 0  -> strip_reject reject   (ADC)
;   OR != 0                           -> strip_clip clip     (ADC; clip_strip if n >= 2)
;   sign of the screen cross == parity-> strip_backface backface (ADC)
;   else drawn, and the stack's drawn flag is set (389)
; ===========================================================================
VIRStrip:
    nop                                  xtop vi11                           ;  317
    nop                                  ilwr.x vi02, (vi11)                 ;  318
    nop                                  iaddiu vi11, vi11, 1                ;  319
    nop                                  iaddiu vi12, vi00, 32767            ;  320
    nop                                  iaddiu vi12, vi12, 1                ;  321
    nop                                  iaddiu vi15, vi00, 1024             ;  322
    nop                                  iaddiu vi10, vi00, 32               ;  323
    nop                                  iaddiu vi03, vi00, 142              ;  324
    nop                                  iaddiu vi09, vi00, 0                ;  325
    nop                                  iaddiu vi13, vi00, 2                ;  326
    nop                                  isubiu vi15, vi15, 1                ;  327
    nop                                  isw.x vi02, 0(vi15)                 ;  328
    nop                                  isw.y vi00, 0(vi15)                 ;  329
    nop                                  lqi.xyz vf21, (vi11++)              ;  330
    nop                                  lqi.xyz vf22, (vi11++)              ;  331
    nop                                  lqi.xyz vf23, (vi11++)              ;  332
    nop                                  lqi.xyzw vf24, (vi11++)             ;  333
    sub.xyz vf26, vf10, vf21             nop                                 ;  334
    mulax.xyzw acc, vf01, vf21x          nop                                 ;  335
    madday.xyzw acc, vf02, vf21y         nop                                 ;  336
    maddaz.xyzw acc, vf03, vf21z         nop                                 ;  337
    maddw.xyzw vf31, vf04, vf00w         erleng.xyz p, vf26                  ;  338
    mul.xyz vf28, vf26, vf26             nop                                 ;  339
    opmula.xyz acc, vf23, vf09           nop                                 ;  340
    madda.x acc, vf23, vf09              nop                                 ;  341
    opmsub.xyz vf25, vf09, vf23          nop                                 ;  342
    ; -- loop: finish vertex n, start n+1
strip_loop:
    mulaz.w acc, vf00, vf28z             div q, vf00w, vf31w                 ;  343
    madday.w acc, vf00, vf28y            nop                                 ;  344
    maddx.w vf25, vf00, vf28x            move.xyzw vf18, vf19                ;  345
    mul.xyz vf28, vf26, vf23             move.xyzw vf19, vf20                ;  346
    mulax.w acc, vf31, vf30x             move.xyzw vf15, vf16                ;  347
    maddy.w vf22, vf00, vf30y            move.xyzw vf16, vf17                ;  348
    nop                                  nop                                 ;  349
    mulq.z vf22, vf22, q                 nop                                 ;  350
    mulaz.w acc, vf00, vf28z             nop                                 ;  351
    madday.w acc, vf00, vf28y            nop                                 ;  352
    maddx.w vf26, vf00, vf28x            nop                                 ;  353
    maxz.w vf22, vf22, vf30z             nop                                 ;  354
    mulw.w vf25, vf25, vf10w             nop                                 ;  355
    mulq.xyz vf20, vf31, q               isubiu vi02, vi02, 1                ;  356
    mulax.xyzw acc, vf05, vf21x          isubiu vi13, vi13, 1                ;  357
    madday.xyzw acc, vf06, vf21y         iadd vi04, vi00, vi05               ;  358
    maddaz.xyzw acc, vf07, vf21z         iadd vi05, vi00, vi06               ;  359
    maddw.xyzw vf17, vf08, vf00w         isub vi09, vi10, vi09               ;  360
    sub.xyz vf27, vf20, vf19             nop                                 ;  361
    minix.x vf25, vf25, vf00x            mfp.w vf27, p                       ;  362
    miniw.w vf20, vf22, vf30w            iand vi14, vi04, vi05               ;  363
    clipw.xyz vf17, vf17w                ior vi07, vi04, vi05                ;  364
    sub.xyz vf26, vf19, vf18             iaddiu vi01, vi00, 63               ;  365
    mulw.w vf25, vf25, vf27w             nop                                 ;  366
    mulw.w vf26, vf26, vf27w             lqi.xyz vf21, (vi11++)              ;  367
    ftoi4.xyzw vf28, vf20                fcget vi06                          ;  368
    miniw.w vf22, vf22, vf30w            iand vi06, vi06, vi01               ;  369
    miniw.w vf25, vf25, vf00w            iand vi14, vi14, vi06               ;  370
    maxx.w vf26, vf26, vf00x             move.w vf27, vf24                   ;  371
    opmula.xyz acc, vf26, vf27           sqi.xyzw vf28, (vi03++)             ;  372
    opmsub.xyz vf00, vf27, vf26          sqi.xyzw vf22, (vi03++)             ;  373
    subw.w vf25, vf00, vf25w             lqi.xyz vf22, (vi11++)              ;  374
    adda.xyz acc, vf24, vf14             lqi.xyz vf23, (vi11++)              ;  375
    msubax.xyz acc, vf12, vf25x          lqi.xyzw vf24, (vi11++)             ;  376
    nop                                  fmand vi08, vi10                    ;  377
    mulw.w vf25, vf25, vf26w             nop                                 ;  378
    nop                                  nop                                 ;  379
    nop                                  mtir vi01, vf28w                    ;  380
    sub.xyz vf26, vf10, vf21             ior vi07, vi07, vi06                ;  381
    maddw.xyz vf27, vf13, vf25w          ibne vi14, vi00, strip_reject              ;  382
    mulax.xyzw acc, vf01, vf21x          nop                                 ;  383
    madday.xyzw acc, vf02, vf21y         ibne vi07, vi00, strip_clip              ;  384
    maddaz.xyzw acc, vf03, vf21z         erleng.xyz p, vf26                  ;  385
    miniw.xyz vf27, vf27, vf00w          ibeq vi08, vi09, strip_backface              ;  386
    maddw.xyzw vf31, vf04, vf00w         nop                                 ;  387
    mul.xyz vf28, vf26, vf26             nop                                 ;  388
    opmula.xyz acc, vf23, vf09           isw.y vi10, 0(vi15)                 ;  389
    madda.x acc, vf23, vf09              ibgtz vi02, strip_loop                   ;  390
    opmsub.xyz vf25, vf09, vf23          sqi.xyzw vf27, (vi03++)             ;  391
    ; -- exit: pop [N, drawn]; if anything was drawn, BAL layer_emitter to emit the layers
strip_exit:
    nop                                  ilwr.y vi02, (vi15)                 ;  392
    nop                                  ilw.x vi01, 0(vi15)                 ;  393
    nop                                  iaddiu vi15, vi15, 1                ;  394
    nop                                  ibeq vi02, vi00, strip_end              ;  395
    nop                                  iaddiu vi02, vi00, 142              ;  396
    nop                                  bal vi12, layer_emitter                     ;  397
    nop                                  iaddiu vi03, vi00, 0                ;  398
strip_end:
    nop[e]                               nop                                 ;  399
    nop                                  nop                                 ;  400
    ; -- reject: ADC on this vertex, then the rest of the pass
strip_reject:
    madday.xyzw acc, vf02, vf21y         nop                                 ;  401
    maddaz.xyzw acc, vf03, vf21z         erleng.xyz p, vf26                  ;  402
    miniw.xyz vf27, vf27, vf00w          nop                                 ;  403
    maddw.xyzw vf31, vf04, vf00w         nop                                 ;  404
    mul.xyz vf28, vf26, vf26             ior vi01, vi12, vi01                ;  405
    opmula.xyz acc, vf23, vf09           isw.w vi01, -2(vi03)                ;  406
    madda.x acc, vf23, vf09              ibgtz vi02, strip_loop                   ;  407
    opmsub.xyz vf25, vf09, vf23          sqi.xyzw vf27, (vi03++)             ;  408
    nop                                  b strip_exit                             ;  409
    nop                                  nop                                 ;  410
    ; -- backface: ADC on this vertex, then the rest of the pass
strip_backface:
    mul.xyz vf28, vf26, vf26             ior vi01, vi12, vi01                ;  411
    opmula.xyz acc, vf23, vf09           isw.w vi01, -2(vi03)                ;  412
    madda.x acc, vf23, vf09              ibgtz vi02, strip_loop                   ;  413
    opmsub.xyz vf25, vf09, vf23          sqi.xyzw vf27, (vi03++)             ;  414
    nop                                  b strip_exit                             ;  415
    nop                                  nop                                 ;  416
    ; -- clip: ADC; from the third vertex on, BAL clip_strip (the clipper, not exercised by the capture)
strip_clip:
    miniw.xyz vf27, vf27, vf00w          ior vi01, vi12, vi01                ;  417
    maddw.xyzw vf31, vf04, vf00w         isw.w vi01, -2(vi03)                ;  418
    mul.xyz vf28, vf26, vf26             nop                                 ;  419
    opmula.xyz acc, vf23, vf09           nop                                 ;  420
    madda.x acc, vf23, vf09              ibgez vi13, strip_loop                   ;  421
    opmsub.xyz vf25, vf09, vf23          sqi.xyzw vf27, (vi03++)             ;  422
    nop                                  bal vi14, clip_strip                     ;  423
    nop                                  nop                                 ;  424
    nop                                  ibgtz vi02, strip_loop                   ;  425
    nop                                  nop                                 ;  426
    nop                                  b strip_exit                             ;  427
    nop                                  nop                                 ;  428
; ===========================================================================
; VIRStrip2 -- PackVUNC (and VIColorBuffer's baked colours).  Integer vertices,
; ITOF0 then times vf29's four pack scales (x position, y (s,t,q), z normal,
; w colour).  433 picks the path on vf11.x = VIRaster::m_p45C8, which
; DrawPrimBufferPackVUNC sets only when the point light is on AND its sphere,
; taken into object space, meets the buffer's box:
;   0 -> strip2_unlit, no point light (READ AND VERIFIED: spec_strip.py 'strip2',
;        1,550 captured runs, 8,077 vertices, bit for bit with their paths)
;   1 -> 435.., lit with the point light -- READ AND VERIFIED ('strip2lit':
;        430 runs, 2,715 vertices): the point term added LAST, after static.rgb,
;        and the sun factor x c.w BEFORE x static.w (the unlit path's reverse;
;        neither order is visible in any capture: vf31 = (0,0,0,1) in all 1,129)
; strip2_unlit's colour = min(c + amb + sun*max(-(N.S)*static.w*c.w, 0) + static.rgb, 1),
; alpha 1: on packed terrain c.w is a per-vertex SUN-VISIBILITY factor, not an
; alpha, and vf31 (qword 20) is the static lighting.  Culling, fog, outputs and
; the 142+ buffer are VIRStrip's.
; ===========================================================================
    nop                                  mtir vi03, vf11x                    ;  429
    nop                                  xtop vi11                           ;  430
    nop                                  ilwr.x vi02, (vi11)                 ;  431
    nop                                  iaddiu vi11, vi11, 1                ;  432
    nop                                  ibeq vi03, vi00, strip2_unlit              ;  433
    nop                                  nop                                 ;  434
    nop                                  iaddiu vi12, vi00, 32767            ;  435
    nop                                  iaddiu vi12, vi12, 1                ;  436
    nop                                  iaddiu vi15, vi00, 1024             ;  437
    nop                                  iaddiu vi10, vi00, 32               ;  438
    nop                                  iaddiu vi03, vi00, 142              ;  439
    nop                                  iaddiu vi09, vi00, 0                ;  440
    nop                                  iaddiu vi13, vi00, 2                ;  441
    nop                                  isubiu vi15, vi15, 1                ;  442
    nop                                  isw.x vi02, 0(vi15)                 ;  443
    nop                                  isw.y vi00, 0(vi15)                 ;  444
    nop                                  lqi.xyz vf21, (vi11++)              ;  445
    nop                                  lqi.xyz vf22, (vi11++)              ;  446
    nop                                  lqi.xyz vf23, (vi11++)              ;  447
    nop                                  lqi.xyzw vf24, (vi11++)             ;  448
    itof0.xyz vf21, vf21                 nop                                 ;  449
    itof0.xyz vf22, vf22                 nop                                 ;  450
    itof0.xyz vf23, vf23                 nop                                 ;  451
    itof0.xyzw vf24, vf24                nop                                 ;  452
    mulx.xyz vf21, vf21, vf29x           nop                                 ;  453
    muly.xyz vf22, vf22, vf29y           nop                                 ;  454
    mulz.xyz vf23, vf23, vf29z           nop                                 ;  455
    mulw.xyzw vf24, vf24, vf29w          nop                                 ;  456
    sub.xyz vf26, vf10, vf21             nop                                 ;  457
strip2_loop:
    mulax.xyzw acc, vf01, vf21x          move.xyzw vf18, vf19                ;  458
    madday.xyzw acc, vf02, vf21y         move.xyzw vf19, vf20                ;  459
    maddaz.xyzw acc, vf03, vf21z         nop                                 ;  460
    maddw.xyzw vf27, vf04, vf00w         erleng.xyz p, vf26                  ;  461
    mul.xyz vf28, vf26, vf26             nop                                 ;  462
    opmula.xyz acc, vf23, vf09           move.xyzw vf15, vf16                ;  463
    madda.x acc, vf23, vf09              move.xyzw vf16, vf17                ;  464
    opmsub.xyz vf25, vf09, vf23          div q, vf00w, vf27w                 ;  465
    mulaz.w acc, vf00, vf28z             nop                                 ;  466
    madday.w acc, vf00, vf28y            nop                                 ;  467
    maddx.w vf25, vf00, vf28x            nop                                 ;  468
    mul.xyz vf28, vf26, vf23             nop                                 ;  469
    mulax.w acc, vf27, vf30x             nop                                 ;  470
    maddy.w vf22, vf00, vf30y            nop                                 ;  471
    mulq.xyz vf20, vf27, q               nop                                 ;  472
    mulq.z vf22, vf22, q                 nop                                 ;  473
    mulaz.w acc, vf00, vf28z             nop                                 ;  474
    madday.w acc, vf00, vf28y            nop                                 ;  475
    maddx.w vf26, vf00, vf28x            nop                                 ;  476
    maxz.w vf22, vf22, vf30z             nop                                 ;  477
    mulw.w vf25, vf25, vf10w             nop                                 ;  478
    mulw.x vf25, vf25, vf24w             isubiu vi02, vi02, 1                ;  479
    mulax.xyzw acc, vf05, vf21x          isubiu vi13, vi13, 1                ;  480
    madday.xyzw acc, vf06, vf21y         iadd vi04, vi00, vi05               ;  481
    maddaz.xyzw acc, vf07, vf21z         iadd vi05, vi00, vi06               ;  482
    maddw.xyzw vf17, vf08, vf00w         isub vi09, vi10, vi09               ;  483
    sub.xyz vf27, vf20, vf19             nop                                 ;  484
    mulw.x vf25, vf25, vf31w             mfp.w vf27, p                       ;  485
    miniw.w vf20, vf22, vf30w            iand vi08, vi04, vi05               ;  486
    clipw.xyz vf17, vf17w                ior vi07, vi04, vi05                ;  487
    sub.xyz vf26, vf19, vf18             iaddiu vi01, vi00, 63               ;  488
    mulw.w vf25, vf25, vf27w             nop                                 ;  489
    mulw.w vf26, vf26, vf27w             nop                                 ;  490
    ftoi4.xyzw vf28, vf20                fcget vi06                          ;  491
    miniw.w vf22, vf22, vf30w            iand vi06, vi06, vi01               ;  492
    miniw.w vf25, vf25, vf00w            iand vi14, vi08, vi06               ;  493
    maxx.w vf26, vf26, vf00x             move.w vf27, vf00                   ;  494
    minix.x vf25, vf25, vf00x            sqi.xyzw vf28, (vi03++)             ;  495
    opmula.xyz acc, vf26, vf27           sqi.xyzw vf22, (vi03++)             ;  496
    subw.w vf25, vf00, vf25w             lqi.xyz vf21, (vi11++)              ;  497
    opmsub.xyz vf00, vf27, vf26          lqi.xyz vf22, (vi11++)              ;  498
    adda.xyz acc, vf24, vf14             lqi.xyz vf23, (vi11++)              ;  499
    msubax.xyz acc, vf12, vf25x          lqi.xyzw vf24, (vi11++)             ;  500
    mulw.w vf25, vf25, vf26w             nop                                 ;  501
    maddaw.xyz acc, vf31, vf00w          fmand vi08, vi10                    ;  502
    itof0.xyz vf21, vf21                 mtir vi01, vf28w                    ;  503
    itof0.xyz vf22, vf22                 ior vi07, vi07, vi06                ;  504
    maddw.xyz vf27, vf13, vf25w          ibne vi14, vi00, strip2_reject              ;  505
