    sub.xyzw vf22, vf22, vf23            iaddiu vi07, vi05, 13               ; 1463
    nop                                  lqi.xyzw vf26, (vi07++)             ; 1464
    nop                                  nop                                 ; 1465
    nop                                  nop                                 ; 1466
    ftoi0.xyzw vf24, vf22                nop                                 ; 1467
    nop                                  lq.xyzw vf20, 1(vi11)               ; 1468
    nop                                  lq.xyzw vf21, 2(vi11)               ; 1469
    nop                                  lq.xyzw vf19, 0(vi11)               ; 1470
    itof0.xyzw vf25, vf24                iaddiu vi11, vi11, 3                ; 1471
