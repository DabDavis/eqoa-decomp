; ===========================================================================
; The layer routines, reached from layer_emitter's jump table at 1075 on the layer's
; pass type (VIMaterial::ConstructDMAPacket's list at 435, 17 qwords a layer:
; +0 type, +1..9 A+D GS state, +10/+11/+12 GIF tag templates strip/fan/line,
; +13 layer colour x 128, +14..16 the UV transform, scroll in row 2).  Each
; turns the 142+ buffer into the layer's GIF packet at 539 -- per vertex
; (u'q, v'q, q), ftoi0(colour * layer colour), XYZF2 -- and kicks it from its
; branch's delay slot.  READ AND VERIFIED: spec_layer.py, 3,635 captured
; packets (88,004 qwords) bit for bit.
;   type 0 solid fill layer_solid (not in the capture)   type 2 wire layer_wire (not in it)
;   type 1 textured, wrap both axes (layer_tex_wrap): first subtracts k = the integer
;          part of (u', v') - 2047/4096 at vertex 0, invisible under wrapping
;   type 3 textured, clamp on S or T (layer_tex_clamp): the same with no offset
; ===========================================================================
layer_tex_wrap:
    nop                                  iaddiu vi07, vi05, 14               ; 1451
    nop                                  lq.xyzw vf20, 1(vi11)               ; 1452
    nop                                  lqi.xyzw vf16, (vi07++)             ; 1453
    nop                                  lqi.xyzw vf17, (vi07++)             ; 1454
    nop                                  lqi.xyzw vf18, (vi07++)             ; 1455
